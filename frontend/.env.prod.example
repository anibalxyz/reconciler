FRONTEND_PROTOCOL=http # Defaults to https

# Used when running locally. Overwritten if running with Docker.
# This value must be changed manually if you modify the API socket in its dotenv file.
API_URL=http://localhost:4002

# ---------------------------------------------- #
# ==> NGINX Configuration                        #
# ---------------------------------------------- #

# Use a short TTL in dev to allow quick DNS updates when containers restart.
# In production, prefer a longer one to reduce DNS lookup overhead.

# Domain for SSL certificates and nginx server_name (e.g. my-app.duckdns.org)
DOMAIN=
# Email for Let's Encrypt registration
CERTBOT_EMAIL=
# true=LE staging (no rate limit), false=production certs
CERTBOT_STAGING=true
# Rate limit per IP for /api/ (nginx limit_req_zone rate)
LIMIT_REQ_RATE=10r/s
# Burst capacity before 503 (nginx limit_req burst)
LIMIT_REQ_BURST=20
NGINX_TTL=10s