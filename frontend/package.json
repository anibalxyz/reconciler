{
  "name": "@anibalxyz/reconciler-frontend",
  "private": true,
  "description": "Reconciler Dashboard app",
  "keywords": [
    "reconciler",
    "finances",
    "ai",
    "bot",
    "assistant",
    "personal",
    "individual",
    "charts",
    "data",
    "modern",
    "react",
    "spa",
    "vite",
    "typescript",
    "javascript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anibalxyz/reconciler.git",
    "directory": "frontend/dashboard"
  },
  "license": "MIT",
  "author": {
    "name": "Anibal Boggio",
    "email": "anibalboggioict@gmail.com",
    "url": "https://github.com/anibalxyz"
  },
  "type": "module",
  "workspaces": [
    "dashboard",
    "public-site"
  ],
  "scripts": {
    "build:dashboard": "npm run build --workspace=@anibalxyz/reconciler-dashboard",
    "build:public": "npm run build --workspace=@anibalxyz/reconciler-public-site",
    "dev:dashboard": "npm run dev --workspace=@anibalxyz/reconciler-dashboard",
    "dev:public": "npm run dev --workspace=@anibalxyz/reconciler-public-site",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "lint": "npm run lint --workspaces",
    "prepare": "cd .. && husky ./frontend/.husky",
    "typecheck": "npm run typecheck --workspaces"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "24.12.4",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.0",
    "vite": "7.3.3",
    "vite-tsconfig-paths": "6.1.1"
  },
  "engines": {
    "node": "^24.16.0"
  }
}
